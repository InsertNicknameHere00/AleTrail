<resources>
    <!-- Стойности за светъл theme. -->
    <style name="Base.Theme.AleTrail" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Основни Material цветове. -->
        <item name="colorPrimary">@color/ale_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/ale_accent</item>
        <item name="colorOnPrimaryContainer">#3D2400</item>
        <item name="colorSecondary">@color/ale_fab_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/ale_bg_dark</item>
        <item name="colorSurface">@color/ale_bg_card</item>
        <item name="colorSurfaceVariant">@color/ale_bg_card_lighter</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/ale_bg_dark</item>
        <item name="android:windowAnimationStyle">@style/AleTrail.WindowAnimation</item>

        <!-- Custom цветове за AleTrail екрани. -->
        <item name="aleCardBackground">@color/ale_bg_card</item>
        <item name="aleCardBackgroundLighter">@color/ale_bg_card_lighter</item>
        <item name="aleTextPrimary">@color/text_primary_dark</item>
        <item name="aleTextSecondary">@color/text_secondary_dark</item>
        <item name="aleTextHint">@color/text_hint_dark</item>
        <item name="aleGold">@color/ale_primary</item>
        <item name="aleButtonText">@color/white</item>
        <item name="aleBadgeCircle">#26D8891C</item>
        <item name="aleBadgeCircleStroke">#66D8891C</item>
        <item name="aleBadgeNameEarned">#965700</item>
        <item name="aleBadgeNameUnearned">#9E9E9E</item>
        <item name="aleBadgeDescriptionText">#6B7280</item>
        <item name="aleChipEarned">#26D8891C</item>
        <item name="aleChipStroke">@color/ale_primary</item>
        <item name="aleDiscountGreen">#2E7D32</item>
        <item name="aleOverlayBg">#14FFFFFF</item>

        <!-- Допълнителни UI token-и. -->
        <item name="aleSurfaceStroke">@color/ale_surface_stroke</item>
        <item name="aleLink">@color/ale_link</item>
        <item name="aleTabText">@color/ale_tab_text</item>
        <item name="aleTabTextSelected">@color/ale_tab_text_selected</item>
        <item name="aleFabSecondary">@color/ale_fab_secondary</item>
        <item name="aleDanger">@color/ale_danger</item>
        <item name="aleDangerContainer">@color/ale_danger_container</item>
    </style>

    <style name="Theme.AleTrail" parent="Base.Theme.AleTrail" />
</resources>