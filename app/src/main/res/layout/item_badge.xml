<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    style="@style/AleTrailCardSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="14dp"
        android:minHeight="160dp">

        <TextView
            android:id="@+id/badgeIcon"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/bg_badge_circle"
            android:gravity="center"
            android:textSize="34sp"
            tools:text="🏆" />

        <TextView
            android:id="@+id/badgeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="?attr/aleTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Bronze Collector" />

        <TextView
            android:id="@+id/badgeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="?attr/aleBadgeDescriptionText"
            android:textSize="11sp"
            tools:text="Collect 10 stamps" />

        <com.google.android.material.chip.Chip
            android:id="@+id/earnedChip"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:text="@string/badge_earned"
            android:textColor="?attr/aleChipStroke"
            android:textSize="11sp"
            android:visibility="gone"
            app:chipBackgroundColor="?attr/aleChipEarned"
            app:chipStrokeColor="?attr/aleChipStroke"
            app:chipStrokeWidth="1dp"
            tools:visibility="visible" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
