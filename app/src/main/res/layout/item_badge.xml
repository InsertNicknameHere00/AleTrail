<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="?attr/aleCardBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="14dp"
        android:minHeight="150dp">

        <!-- Badge Icon/Emoji -->
        <TextView
            android:id="@+id/badgeIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:textSize="36sp"
            android:background="@drawable/bg_badge_circle"
            tools:text="🏆" />

        <!-- Badge Name -->
        <TextView
            android:id="@+id/badgeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/aleTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            tools:text="Bronze Collector" />

        <!-- Badge Description -->
        <TextView
            android:id="@+id/badgeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/aleBadgeDescriptionText"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            tools:text="Collect 10 stamps" />

        <!-- Earned Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/earnedChip"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="@string/badge_earned"
            android:textColor="?attr/aleChipStroke"
            android:textSize="10sp"
            app:chipBackgroundColor="?attr/aleChipEarned"
            app:chipStrokeColor="?attr/aleChipStroke"
            app:chipStrokeWidth="1dp"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
