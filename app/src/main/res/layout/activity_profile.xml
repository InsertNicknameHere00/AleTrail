<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_beer_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:animateLayoutChanges="true"
        android:padding="24dp">

        <!-- Горен ред. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="@string/dialog_cancel"
                app:tint="?attr/aleGold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/profile_title"
                style="@style/AleTrailTextToolbarTitle" />
        </LinearLayout>

        <!-- Блок с аватар. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp">

                <View
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_avatar_circle" />

                <!-- Реалната снимка, ако user има такава. -->
                <ImageView
                    android:id="@+id/avatarImage"
                    android:layout_width="114dp"
                    android:layout_height="114dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@string/profile_avatar_desc" />

                <!-- Резервно: първата буква от името. -->
                <TextView
                    android:id="@+id/avatarInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/avatar_placeholder"
                    android:textColor="?attr/aleGold"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/avatarEditButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_avatar_edit"
                    android:src="@android:drawable/ic_menu_camera"
                    android:padding="6dp"
                    android:contentDescription="@string/profile_change_photo"
                    app:tint="?attr/aleButtonText" />
            </FrameLayout>
        </LinearLayout>

        <!-- Карта с editable profile данни. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/profileCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/AleTrailCardSurfaceLarge">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_display_name_label"
                    style="@style/AleTrailTextSectionHint"
                    android:textColor="?attr/aleGold"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/AleTrail.TextInput.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profileNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/aleTextPrimary"
                        android:textColorHint="?attr/aleTextHint"
                        android:inputType="textPersonName"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Имейлът тук е само за показване. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_email_label"
                    android:textColor="?attr/aleGold"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/profileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/aleTextSecondary"
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:background="@drawable/bg_input_field"
                    android:layout_marginBottom="16dp" />

                <!-- Текст "member since". -->
                <TextView
                    android:id="@+id/memberSince"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/aleTextHint"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Карта със stats. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/AleTrailCardSurfaceLarge">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_title"
                    style="@style/AleTrailTextSectionTitle"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/profileStamps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_zero"
                            android:textColor="?attr/aleGold"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_stamps"
                            android:textColor="?attr/aleTextSecondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/profileVisits"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_zero"
                            android:textColor="?attr/aleGold"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_visits"
                            android:textColor="?attr/aleTextSecondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/profileBadges"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_zero"
                            android:textColor="?attr/aleGold"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_badges"
                            android:textColor="?attr/aleTextSecondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Банер, който се вижда само в guest mode. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/guestBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            style="@style/AleTrailCardSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_guest_mode"
                    android:textColor="?attr/aleGold"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_guest_message"
                    android:textColor="?attr/aleTextSecondary"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/signInNowButton"
                    style="@style/AleTrail.Button.Primary.DarkText"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/btn_sign_in_now" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Карта с настройки и account действия. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/AleTrailCardSurfaceLarge">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_settings_title"
                    android:textColor="?attr/aleGold"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Ред за dark mode toggle. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_dark_mode"
                        android:textColor="?attr/aleTextSecondary"
                        android:textSize="15sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/darkModeSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="?attr/aleGold"
                        app:trackTint="?attr/aleChipEarned" />
                </LinearLayout>

                <!-- Контроли за email verification. -->
                <LinearLayout
                    android:id="@+id/verifyEmailRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/verifyEmailStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_email_not_verified"
                        android:textColor="?attr/aleDanger"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/verifyEmailButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/profile_verify_email"
                        android:textColor="?attr/aleButtonText"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:background="@drawable/bg_button_primary" />
                </LinearLayout>

                <!-- Бутон за delete account. -->
                <Button
                    android:id="@+id/deleteAccountButton"
                    style="@style/AleTrail.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/btn_delete_account"
                    android:textColor="?attr/aleDanger" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bottom actions card. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/actionsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/AleTrailCardSurfaceLarge">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/myReviewsButton"
                        style="@style/AleTrail.Button.Muted"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="@string/ratings_title"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/createBusinessButton"
                        style="@style/AleTrail.Button.Muted"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="@string/business_title"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/viewFavoritesMapButton"
                    style="@style/AleTrail.Button.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/map_create_button"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/saveProfileButton"
                    style="@style/AleTrail.Button.Primary.DarkText"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/btn_save_profile"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/signOutButton"
                    style="@style/AleTrail.Button.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/btn_sign_out"
                    android:textSize="16sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Spinner при profile действия. -->
        <ProgressBar
            android:id="@+id/profileLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="?attr/aleGold" />

    </LinearLayout>
</ScrollView>

