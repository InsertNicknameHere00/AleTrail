<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    style="@style/AleTrailCardSurfaceLarge">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_loyalty_card"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/cardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/loyalty_card_title"
                android:textAllCaps="true"
                android:textColor="?attr/aleTextHint"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stampCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_brewery_item"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="?attr/aleGold"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="3/100" />
        </LinearLayout>

        <TextView
            android:id="@+id/cardBreweryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/aleTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Crafty Brewery Co." />

        <TextView
            android:id="@+id/stampsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_stamps_collected"
            android:textAllCaps="true"
            android:textColor="?attr/aleTextHint"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/stampProgressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="30"
            android:progressDrawable="@drawable/progress_stamps" />

        <TextView
            android:id="@+id/stampEmojis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:textSize="20sp"
            tools:text="⭐⭐⭐⚪⚪⚪⚪⚪⚪⚪" />

        <TextView
            android:id="@+id/discountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="?attr/aleDiscountGreen"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Current Discount: 10%"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <Button
                android:id="@+id/shareButton"
                style="@style/AleTrail.Button.Surface"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/button_share"
                android:textSize="11sp" />

            <Button
                android:id="@+id/viewHistoryButton"
                style="@style/AleTrail.Button.Surface"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="@string/button_history"
                android:textSize="11sp" />

            <Button
                android:id="@+id/deleteCardButton"
                style="@style/AleTrail.Button.Danger"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button_danger"
                android:backgroundTint="@color/ale_danger"
                android:text="@string/dialog_delete"
                android:textColor="@android:color/white"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
