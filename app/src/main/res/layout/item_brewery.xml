<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    style="@style/AleTrailCardSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <ImageView
            android:id="@+id/breweryIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_primary"
            android:contentDescription="@string/content_brewery_icon"
            android:padding="8dp"
            android:src="@drawable/ic_brewery"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/aleButtonText" />

        <ImageButton
            android:id="@+id/favoriteButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_add_favorite"
            android:src="@drawable/ic_favorite_border"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/aleGold" />

        <TextView
            android:id="@+id/breweryName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/aleTextPrimary"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/favoriteButton"
            app:layout_constraintStart_toEndOf="@id/breweryIcon"
            app:layout_constraintTop_toTopOf="@id/breweryIcon"
            tools:text="Crafty Brewery Co." />

        <TextView
            android:id="@+id/breweryType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_button_primary"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="?attr/aleButtonText"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/breweryName"
            app:layout_constraintTop_toBottomOf="@id/breweryName"
            tools:text="MICRO" />

        <TextView
            android:id="@+id/breweryAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/aleTextSecondary"
            android:textSize="13sp"
            app:drawableStartCompat="@drawable/ic_location"
            android:drawablePadding="6dp"
            app:drawableTint="?attr/aleGold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/breweryIcon"
            tools:text="123 Beer St, San Francisco, CA 94102" />

        <TextView
            android:id="@+id/breweryPhone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textColor="?attr/aleTextSecondary"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_phone"
            android:drawablePadding="6dp"
            app:drawableTint="?attr/aleGold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/breweryAddress"
            tools:text="(555) 123-4567" />

        <TextView
            android:id="@+id/breweryWebsite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autoLink="web"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/aleLink"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_brewery"
            android:drawablePadding="6dp"
            app:drawableTint="?attr/aleGold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/breweryPhone"
            tools:text="www.craftybrewery.com" />

        <TextView
            android:id="@+id/holdHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/brewery_hold_actions_hint"
            android:textColor="?attr/aleTextHint"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/breweryWebsite" />

        <Button
            android:id="@+id/removeFavoriteButton"
            style="@style/AleTrail.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="?attr/aleDanger"
            android:text="@string/button_remove_favorite"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/holdHint" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
