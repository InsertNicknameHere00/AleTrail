<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#2D1F0A">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Brewery Icon -->
        <ImageView
            android:id="@+id/breweryIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_brewery"
            android:contentDescription="Brewery icon"
            android:padding="8dp"
            android:background="@drawable/bg_button_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="#1A1A1A" />

        <!-- Brewery Name -->
        <TextView
            android:id="@+id/breweryName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Crafty Brewery Co."
            app:layout_constraintTop_toTopOf="@id/breweryIcon"
            app:layout_constraintStart_toEndOf="@id/breweryIcon"
            app:layout_constraintEnd_toStartOf="@id/favoriteButton" />

        <!-- Brewery Type Chip -->
        <TextView
            android:id="@+id/breweryType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:textColor="#1A1A1A"
            android:background="@drawable/bg_button_primary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textStyle="bold"
            android:maxLines="1"
            tools:text="MICRO"
            app:layout_constraintTop_toBottomOf="@id/breweryName"
            app:layout_constraintStart_toStartOf="@id/breweryName" />

        <!-- Favorite Button -->
        <ImageButton
            android:id="@+id/favoriteButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_favorite_border"
            android:contentDescription="Add to favorites"
            app:tint="#FFD54F"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#4DFFFFFF"
            app:layout_constraintTop_toBottomOf="@id/breweryIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Full Address -->
        <TextView
            android:id="@+id/breweryAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp"
            android:textColor="#E0E0E0"
            android:maxLines="2"
            android:ellipsize="end"
            android:drawableStart="@drawable/ic_location"
            android:drawablePadding="6dp"
            android:drawableTint="#FFD54F"
            tools:text="123 Beer St, San Francisco, CA 94102"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Phone -->
        <TextView
            android:id="@+id/breweryPhone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:textColor="#E0E0E0"
            android:maxLines="1"
            android:drawableStart="@drawable/ic_qr_code"
            android:drawablePadding="6dp"
            android:drawableTint="#FFD54F"
            tools:text="(555) 123-4567"
            app:layout_constraintTop_toBottomOf="@id/breweryAddress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Website -->
        <TextView
            android:id="@+id/breweryWebsite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:textColor="#80DEEA"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoLink="web"
            android:drawableStart="@drawable/ic_brewery"
            android:drawablePadding="6dp"
            android:drawableTint="#FFD54F"
            tools:text="www.craftybrewery.com"
            app:layout_constraintTop_toBottomOf="@id/breweryPhone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Create Card Button -->
        <Button
            android:id="@+id/createCardButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="🎫 Create Loyalty Card"
            android:textColor="#1A1A1A"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            app:layout_constraintTop_toBottomOf="@id/breweryWebsite"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Remove from Favorites Button -->
        <Button
            android:id="@+id/removeFavoriteButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="⭐ Remove from Favorites"
            android:textColor="#1A1A1A"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/createCardButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
