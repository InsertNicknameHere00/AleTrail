<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_beer_gradient"
    android:padding="24dp">

    <!-- Горен ред с бутон назад и заглавие. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="@string/dialog_cancel"
            app:tint="?attr/aleGold" />

        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/dialog_visit_history_title"
            android:textColor="?attr/aleTabTextSelected"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Празен текст, ако няма посещения. -->
    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/visit_history_empty"
        android:textColor="?attr/aleTextHint"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="40dp"
        android:visibility="gone" />

    <!-- Контейнер за списъка с посещения. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutAnimation="@anim/layout_list_enter"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
